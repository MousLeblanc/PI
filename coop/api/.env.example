DATABASE_URL="postgresql://picoop:picoop@127.0.0.1:5433/picoop?schema=public"
# Prod: URL Neon/Supabase (sslmode=require)

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV="development"

# Frontend origins (comma-separated in prod)
CORS_ORIGIN="http://localhost:3000"

# Cloudflare Turnstile — set SKIP=false in production
TURNSTILE_SECRET_KEY=""
TURNSTILE_SKIP="true"
# Hostnames returned by siteverify (no scheme). Prod must NOT include localhost.
TURNSTILE_HOSTNAMES="localhost,127.0.0.1"

# Email — Resend (preferred). If RESEND_API_KEY empty → console log only
RESEND_API_KEY=""
EMAIL_FROM="Pi COOP <onboarding@resend.dev>"
APP_PUBLIC_URL="http://localhost:3000"

# Rate limit (register)
RATE_LIMIT_REGISTER_MAX="5"
RATE_LIMIT_REGISTER_WINDOW_MS="600000"
