generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgeBand {
  AGE_0_4
  AGE_5_17
  AGE_18_64
  AGE_65_PLUS
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(320)
  passwordHash      String    @map("password_hash")
  householdSize     Int       @map("household_size")
  ageBands          AgeBand[] @map("age_bands")
  postalCode        String    @map("postal_code") @db.VarChar(8)
  streetName        String    @map("street_name") @db.VarChar(160)
  houseNumber       String    @map("house_number") @db.VarChar(32)
  optInPublicNumber Boolean   @default(false) @map("opt_in_public_number")
  walletAddress     String?   @map("wallet_address") @db.VarChar(128)
  managedByUserId   String?   @map("managed_by_user_id") @db.Uuid
  emailVerifiedAt   DateTime? @map("email_verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  managedBy User?  @relation("ManagedAccounts", fields: [managedByUserId], references: [id])
  manages   User[] @relation("ManagedAccounts")

  @@index([postalCode])
  @@index([streetName, postalCode])
  @@map("users")
}
